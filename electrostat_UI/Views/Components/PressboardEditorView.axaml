<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:cvm="using:electrostat_UI.ViewModels.Components"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="420"
			 x:Class="electrostat_UI.Views.Components.PressboardEditorView"
			 x:DataType="cvm:PressboardViewModel">
	<StackPanel Spacing="8">
		<TextBlock Classes="page-title" Text="Pressboard Barrier"/>
		<TextBlock Classes="section-title" Text="General and Geometry"/>
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="6">
			<TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
			<TextBlock Grid.Row="1" Grid.Column="0" Text="Inner radius (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding R0}"/>
			<TextBlock Grid.Row="2" Grid.Column="0" Text="Bottom position (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ZBottom}"/>
			<TextBlock Grid.Row="3" Grid.Column="0" Text="Thickness (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Thickness}"/>
			<TextBlock Grid.Row="4" Grid.Column="0" Text="Axial height (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Height}"/>
			<TextBlock Grid.Row="5" Grid.Column="0" Text="Relative permittivity (εᵣ)" VerticalAlignment="Center"
					   ToolTip.Tip="Dimensionless dielectric constant used for this pressboard region."/>
			<NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding RelativePermittivity}" FormatString="0.###"/>
		</Grid>
		<TextBlock Classes="validation-error" IsVisible="{Binding HasPermittivityError}"
				   Text="{Binding PermittivityValidationMessage}"/>

		<Expander Classes="inspector-section" Header="Advanced — Top taper" IsExpanded="False">
			<StackPanel Spacing="2">
				<CheckBox Content="Enable top taper" IsChecked="{Binding TaperTop.Enabled}"/>
				<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="6"
					  IsEnabled="{Binding TaperTop.Enabled}">
					<TextBlock Grid.Row="0" Grid.Column="0" Text="Length (mm)" VerticalAlignment="Center"/>
					<NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TaperTop.Length}"/>
					<TextBlock Grid.Row="1" Grid.Column="0" Text="End thickness (mm)" VerticalAlignment="Center"/>
					<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TaperTop.EndThickness}"/>
					<TextBlock Grid.Row="2" Grid.Column="0" Text="Side" VerticalAlignment="Center"/>
					<ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
							  ItemsSource="{x:Static cvm:TaperViewModel.SideOptions}"
							  SelectedItem="{Binding TaperTop.Side}"/>
				</Grid>
			</StackPanel>
		</Expander>

		<Expander Classes="inspector-section" Header="Advanced — Bottom taper" IsExpanded="False">
			<StackPanel Spacing="2">
				<CheckBox Content="Enable bottom taper" IsChecked="{Binding TaperBottom.Enabled}"/>
				<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="6"
					  IsEnabled="{Binding TaperBottom.Enabled}">
					<TextBlock Grid.Row="0" Grid.Column="0" Text="Length (mm)" VerticalAlignment="Center"/>
					<NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TaperBottom.Length}"/>
					<TextBlock Grid.Row="1" Grid.Column="0" Text="End thickness (mm)" VerticalAlignment="Center"/>
					<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TaperBottom.EndThickness}"/>
					<TextBlock Grid.Row="2" Grid.Column="0" Text="Side" VerticalAlignment="Center"/>
					<ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
							  ItemsSource="{x:Static cvm:TaperViewModel.SideOptions}"
							  SelectedItem="{Binding TaperBottom.Side}"/>
				</Grid>
			</StackPanel>
		</Expander>
	</StackPanel>
</UserControl>
