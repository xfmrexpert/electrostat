<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:cvm="using:electrostat_UI.ViewModels.Components"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="360"
			 x:Class="electrostat_UI.Views.Components.StaticRingEditorView"
			 x:DataType="cvm:StaticRingViewModel">
	<StackPanel Spacing="8">
		<TextBlock Classes="page-title" Text="Static Ring"/>
		<TextBlock Classes="section-title" Text="General, Geometry, and Electrical"/>
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="6">
			<TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
			<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
			<TextBlock Grid.Row="1" Grid.Column="0" Text="Inner radius (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding R0}"/>
			<TextBlock Grid.Row="2" Grid.Column="0" Text="Bottom position (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ZBottom}"/>
			<TextBlock Grid.Row="3" Grid.Column="0" Text="Radial width (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Width}"/>
			<TextBlock Grid.Row="4" Grid.Column="0" Text="Axial height (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Height}"/>
			<TextBlock Grid.Row="5" Grid.Column="0" Text="Top-left radius (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding RTL}"/>
			<TextBlock Grid.Row="6" Grid.Column="0" Text="Top-right radius (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding RTR}"/>
			<TextBlock Grid.Row="7" Grid.Column="0" Text="Bottom-right radius (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding RBR}"/>
			<TextBlock Grid.Row="8" Grid.Column="0" Text="Bottom-left radius (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding RBL}"/>
			<TextBlock Grid.Row="9" Grid.Column="0" Text="Paper thickness (mm)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding TPaper}"/>
			<TextBlock Grid.Row="10" Grid.Column="0" Text="Paper permittivity (εᵣ)" VerticalAlignment="Center"
					   ToolTip.Tip="Dimensionless dielectric constant used for this ring's paper-wrap region."/>
			<NumericUpDown Grid.Row="10" Grid.Column="1" Value="{Binding PaperRelativePermittivity}" FormatString="0.###"/>
			<TextBlock Grid.Row="11" Grid.Column="0" Text="Parent winding" VerticalAlignment="Center"/>
			<ComboBox Grid.Row="11" Grid.Column="1" HorizontalAlignment="Stretch"
					  ItemsSource="{Binding AvailableWindings}"
					  SelectedItem="{Binding ParentWinding, Mode=TwoWay}"/>
			<TextBlock Grid.Row="12" Grid.Column="0" Text="Voltage (V)" VerticalAlignment="Center"/>
			<NumericUpDown Grid.Row="12" Grid.Column="1" Value="{Binding Voltage}"
						   IsEnabled="{Binding IsVoltageEditable}"/>
			<TextBlock Grid.Row="13" Grid.Column="1" Classes="help-text"
					   IsVisible="{Binding IsVoltageInherited}"
					   Text="{Binding InheritedVoltageText}"/>
		</Grid>
		<TextBlock Classes="validation-error" IsVisible="{Binding HasPermittivityError}"
				   Text="{Binding PermittivityValidationMessage}"/>
	</StackPanel>
</UserControl>
